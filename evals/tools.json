   "prompt": "[A.ai:script]{\"steps\": [[{\"name\": \"write_document\", \"args\": {\"purpose\": \"测试\", \"path\": \"{file:old.docx}\", \"content\": \"# 新\"}}]], \"final\": \"完成\"}",
   "checks": {
    "statuses": [

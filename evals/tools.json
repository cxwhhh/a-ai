 "cases": [
  {
   "id": "N01",
   "category": "新工具",
   "title": "write_document 生成 docx / xlsx / pptx",
   "prompt": "[A.ai:script]{\"steps\": [[{\"name\": \"write_document\", \"args\": {\"purpose\": \"测试\", \"path\": \"{dir}/r.docx\", \"content\": \"# 周报\\n- 完成 A\\n\\n| 地区 | 金额 |\\n|---|---|\\n| 东京 | 120 |\"}}, {\"name\": \"write_document\", \"args\": {\"purpose\": \"测试\", \"path\": \"{dir}/d.xlsx\", \"sheets\": [{\"name\": \"销售\", \"rows\": [[\"月份\", \"金额\"], [\"1月\", 120]]}]}}, {\"name\": \"write_document\", \"args\": {\"purpose\": \"测试\", \"path\": \"{dir}/s.pptx\", \"content\": \"# 汇报\\n\\n# 要点\\n- 一\"}}]], \"final\": \"完成\"}",
   "checks": {
    "statuses": [
     {
      "tool": "write_document",
      "status": "ok"
     }
    ],
    "files": [
     {
      "path": "{dir}/r.docx"
     },
     {
      "path": "{dir}/d.xlsx"
     },
     {
      "path": "{dir}/s.pptx"
     }
    ]
   }
  },
  {

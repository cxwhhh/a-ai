{
  "name": "a-ai",
  "productName": "A.ai",
  "version": "0.1.9",
  "private": true,
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server/server.mjs",
    "typecheck": "tsc -p vendor/tsconfig.json && tsc --noEmit",
    "check:dependencies": "node --experimental-strip-types scripts/check-dependencies.ts",
    "test": "pnpm build && node --test \"tests/*.test.mjs\" \"packages/**/test/*.test.mjs\" \"apps/**/test/*.test.mjs\" \"vendor/cordis/tests/*.test.mjs\"",
    "electron:prepare": "node scripts/electron-prepare.mjs",
    "electron:dev": "pnpm build && node scripts/electron-prepare.mjs && electron .",
    "dist:win": "pnpm build && node scripts/electron-prepare.mjs && node scripts/package-desktop.mjs --win",
    "dist:mac": "pnpm build && node scripts/electron-prepare.mjs && node scripts/package-desktop.mjs --mac",
    "cli": "node dist/cli/main.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "docx": "9.15.0",
    "highlight.js": "11.11.1",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "@A-ai/cordis": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "A.ai：极简高效的 AI agent",
  "author": "A.ai",
  "main": "dist-electron/main.cjs",
  "macSigned": false,
  "packageManager": "pnpm@11.10.0",
  "type": "module"
}
